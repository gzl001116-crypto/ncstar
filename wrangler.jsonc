{
  "name": "ncstar",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-12",
  "observability": {
    "enabled": true
  },
  // Keep variables saved in the Cloudflare dashboard, including the Resend key.
  // The key itself stays there. This file is in a public repository, so it does not contain the value.
  "keep_vars": true,
  "durable_objects": {
    "bindings": [
      { "name": "FANSTAR", "class_name": "FanstarStore" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["FanstarStore"] }
  ],
  "triggers": {
    "crons": ["0 0 * * FRI"]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Every request hits the worker first so /play can redirect to play.fanstar.dev.
    "run_worker_first": true
  }
}
